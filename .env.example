# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_delivery?sslmode=disable
MONGO_URI=mongodb://localhost:27017
MONGO_DB=food_delivery

# Redis
REDIS_URI=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# Password
PASSWORD_PEPPER=your-pepper-change-in-production

# Superadmin (created on first run)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=Admin@123

# Firebase (for push notifications, Google sign-in)
FIREBASE_PROJECT_ID=food-delivery-4479f
FIREBASE_CREDENTIALS_PATH=./food-delivery-4479f-firebase-adminsdk-fbsvc-e96b9be0ce.json

# File uploads
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=52428800

# Service addresses (for gateway, when running locally)
AUTH_SERVICE_ADDR=localhost:50051
USER_SERVICE_ADDR=localhost:50052
NOTIFICATION_SERVICE_ADDR=localhost:50053
FILE_STORAGE_SERVICE_ADDR=localhost:50054
RESTAURANT_SERVICE_ADDR=localhost:50055
ORDER_SERVICE_ADDR=localhost:50056
DELIVERY_SERVICE_ADDR=localhost:50057

# Gateway
GATEWAY_BASE_URL=http://localhost:8080

# Environment
ENV=development

# Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
